# Supabase → your project → Connect → Session pooler. Use that string for both URLs (add
# ?connection_limit=10 to DATABASE_URL) and put your database password in place of [YOUR-PASSWORD].
# Session pooler (port 5432) — used by the app. Limit stays under Supabase's pool size (15 on free).
# Deploying serverless (e.g. Vercel)? Use the transaction pooler instead:
#   ...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connection_limit=10"
# Same session pooler, used by `prisma db push`:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Password that unlocks all write actions in the app
ADMIN_PASSWORD="change-me"
